            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{session_id}}\",\n  \"question\": \"What is the refund policy?\",\n  \"answer\": \"Refunds are available within 30 days.\",\n  \"rating\": 1,\n  \"timestamp\": \"2026-05-23T15:30:00Z\"\n}",
              "options": {
