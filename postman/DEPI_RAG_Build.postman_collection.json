{
  "info": {
    "_postman_id": "2b7db5d5-f6d6-4bd1-82b2-df69509af0d6",
    "name": "DEPI RAG API",
    "description": "Postman collection for the DEPI RAG API. Set base_url to your API host, usually http://localhost:8000, and api_key to the value configured in .env. Upload a PDF first; the upload response stores file_id as a collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "change-me",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "postman-session-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Unauthenticated process health check."
          },
          "response": []
        },
        {
          "name": "GET /health/qdrant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/qdrant",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health",
                "qdrant"
              ]
            },
            "description": "Authenticated Qdrant health and point-count check."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "POST /files - Upload PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('upload succeeded', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.file_id) {",
                  "  pm.collectionVariables.set('file_id', body.file_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/files",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ]
            },
            "description": "Choose a local PDF in the file form field. The response stores file_id automatically for later build, status, and delete requests."
          },
          "response": []
        },
        {
          "name": "POST /files/build - Build All Files",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files/build",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files",
                "build"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /files/build?file_id={{file_id}} - Build One File",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files/build?file_id={{file_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files",
                "build"
              ],
              "query": [
                {
                  "key": "file_id",
                  "value": "{{file_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /files - List Files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /files?file_id={{file_id}} - Get File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files?file_id={{file_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ],
              "query": [
                {
                  "key": "file_id",
                  "value": "{{file_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /files?file_id={{file_id}} - Delete One File",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files?file_id={{file_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ],
              "query": [
                {
                  "key": "file_id",
                  "value": "{{file_id}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /files - Delete All Files",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/files",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "files"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inference",
      "item": [
        {
          "name": "POST /ask - Ask Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the refund policy?\",\n  \"mode\": \"hybrid\",\n  \"include_sources\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST /ask - Ask With Source Filter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ask",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Summarize this document.\",\n  \"source\": \"sample.pdf\",\n  \"mode\": \"hybrid\",\n  \"score_threshold\": 0.6,\n  \"include_sources\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST /ask/stream - Stream Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ask/stream",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ask",
                "stream"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What are the main points?\",\n  \"mode\": \"hybrid\",\n  \"include_sources\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns application/x-ndjson streaming chunks."
          },
          "response": []
        }
      ]
    },
    {
