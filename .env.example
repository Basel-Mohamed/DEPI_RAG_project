# Application
APP_NAME=rag_app
APP_VERSION=0.1.0
DEPLOYMENT_ENV=production
LOG_LEVEL=INFO
AUTH_ENABLED=True
API_KEY=replace-with-a-long-random-secret
API_KEY_HEADER=X-API-Key

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Metadata and artifact storage
METADATA_BACKEND=sqlite
METADATA_DB_PATH=uploads/app_metadata.sqlite3
AZURE_SQL_CONNECTION_STRING=
ARTIFACT_STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rag-artifacts
MINIO_SECURE=False
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=rag-artifacts

# Embedding and sparse retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_MODEL=Qdrant/bm25

# Docker Qdrant defaults for local development
QDRANT_REMOTE=True
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PREFER_GRPC=False
QDRANT_HTTPS=False
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_storage

# Collection and retrieval
COLLECTION_NAME=documents
SCORE_THRESHOLD=0.6
DENSE_VECTOR_SIZE=1024
DENSE_ON_DISK=False
SPARSE_ON_DISK=False
RETRIEVAL_MODE=hybrid

# Qdrant index tuning
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_FULL_SCAN_THRESHOLD=10000
HNSW_ON_DISK=False
OPTIMIZATION_INDEXING_THRESHOLD=20000
OPTIMIZATION_MEMMAP_THRESHOLD=50000
QUANTIZATION_QUANTILE=0.99
QUANTIZATION_ALWAYS_RAM=True

# Retrieval and reranking
RETRIEVAL_CANDIDATE_TOP_K=10
RERANKED_CONTEXT_TOP_K=5

# LLM provider: cohere or azure
LLM_PROVIDER=cohere
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=400

# Cohere
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-a-03-2025

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional reranking: cohere, azure_cohere, or blank
RERANKER_PROVIDER=
COHERE_RERANK_MODEL=rerank-v3.5
AZURE_COHERE_BASE_URL=
AZURE_COHERE_API_KEY=
AZURE_COHERE_MODEL=model

# Evaluation and MLflow
MLFLOW_TRACKING_URI=file:./mlruns
EVAL_DATA_PATH=data/evaluation/questions.json
EVAL_OUTPUT_DIR=reports/evaluation
